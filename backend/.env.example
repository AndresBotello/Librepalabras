PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,https://tu-frontend.com
NODE_ENV=development
AUTH_SESSION_MAX_AGE_MS=432000000
ADMIN_EMAILS=admin@tu-dominio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opcional: si prefieres pegar el JSON completo como una sola línea
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Cloudinary - para subir imágenes y PDFs
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret