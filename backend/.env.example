PORT=3000
HOST=0.0.0.0

# En producción tiene que ser exactamente "production": de ahí dependen la
# cookie de sesión (Secure + SameSite=None), el rate limiting y trust proxy.
NODE_ENV=development

# Dominios del frontend autorizados, separados por coma. Obligatorio en
# producción: sin esto el servidor no arranca.
#
# Un origen es esquema + dominio, sin barra final y sin ruta. En producción el
# valor es https://librepalabras.com (el www redirige al dominio raíz, así que
# no hace falta listarlo aparte).
CORS_ORIGIN=http://localhost:5173,https://librepalabras.com

AUTH_SESSION_MAX_AGE_MS=432000000
ADMIN_EMAILS=admin@tu-dominio.com

# Credencial de Firebase Admin. En local basta con el archivo:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# En producción el archivo no se sube al repositorio, así que se pega el JSON
# completo en una sola línea (tiene prioridad sobre la ruta de arriba):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Cloudinary - para subir imágenes y PDFs
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# URL del frontend para armar el enlace de las invitaciones. Si no se define se
# usa el primer valor de CORS_ORIGIN.
CLIENT_URL=https://librepalabras.com

# Nombre que aparece en el correo de invitación.
SITE_NAME=Liberapalabras

# ---------------------------------------------------------------------------
# Correo (OPCIONAL)
#
# Sin esto las invitaciones siguen funcionando: el panel genera un enlace que el
# administrador copia y comparte por donde quiera. Definir estas dos variables
# añade el envío automático por correo, nada más.
#
# También es lo que activa el recordatorio automático de una cátedra del Grupo
# Focal a quien confirmó asistencia (un día antes). Sin SMTP configurado, el
# RSVP sigue funcionando pero nadie recibe el aviso por correo.
#
# Con Gmail hay que usar una CONTRASEÑA DE APLICACIÓN, no la del correo:
# Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de
# aplicaciones. Sin verificación en dos pasos activada la opción no aparece.
# ---------------------------------------------------------------------------
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Liberapalabras <tu-correo@gmail.com>"
